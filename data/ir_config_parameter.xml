<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
          Feature flag per CAMPSCOUT_MASTER_TZ.md §4.6 ЗАКОН + §2 Strangler Fig.
          Default False keeps the module inert so any prior behaviour owning
          the same domain keeps working until the intentional flip.
        -->
        <record id="ir_config_parameter_fayna_sms_base_active" model="ir.config_parameter">
            <field name="key">fayna_sms_base.active</field>
            <field name="value">False</field>
        </record>

        <!--
          Default provider technical name.  Leave empty until a concrete
          provider module is installed and configured.
        -->
        <record id="param_sms_default_provider" model="ir.config_parameter">
            <field name="key">fayna_sms_base.default_provider</field>
            <field name="value"></field>
        </record>

    </data>
</odoo>
