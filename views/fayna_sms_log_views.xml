<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Tree view ────────────────────────────────────────────────────── -->
    <record id="fayna_sms_log_view_tree" model="ir.ui.view">
        <field name="name">fayna.sms.log.tree</field>
        <field name="model">fayna.sms.log</field>
        <field name="arch" type="xml">
            <tree string="SMS Log" default_order="create_date desc">
                <field name="create_date" string="Date" readonly="1"/>
                <field name="provider_name" readonly="1"/>
                <field name="recipient_number" readonly="1"/>
                <field name="partner_id" readonly="1"/>
                <field name="status" readonly="1"
                       decoration-success="status == 'sent' or status == 'delivered'"
                       decoration-danger="status == 'failed'"
                       decoration-muted="status == 'pending'"/>
                <field name="sent_at" readonly="1"/>
            </tree>
        </field>
    </record>

    <!-- ── Form view ────────────────────────────────────────────────────── -->
    <record id="fayna_sms_log_view_form" model="ir.ui.view">
        <field name="name">fayna.sms.log.form</field>
        <field name="model">fayna.sms.log</field>
        <field name="arch" type="xml">
            <form string="SMS Log Entry" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Sender">
                            <field name="provider_name" readonly="1"/>
                            <field name="create_date" string="Date" readonly="1"/>
                        </group>
                        <group string="Recipient">
                            <field name="recipient_number" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="body" readonly="1" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Delivery result">
                        <group>
                            <field name="status" readonly="1"/>
                            <field name="sent_at" readonly="1"/>
                            <field name="external_message_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="error_message" readonly="1"/>
                        </group>
                    </group>
                    <group string="Source record" groups="base.group_system">
                        <field name="model_name" readonly="1"/>
                        <field name="record_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search view ──────────────────────────────────────────────────── -->
    <record id="fayna_sms_log_view_search" model="ir.ui.view">
        <field name="name">fayna.sms.log.search</field>
        <field name="model">fayna.sms.log</field>
        <field name="arch" type="xml">
            <search string="SMS Log">
                <field name="recipient_number"/>
                <field name="partner_id"/>
                <field name="provider_name"/>
                <filter string="Pending" name="filter_pending"
                        domain="[('status', '=', 'pending')]"/>
                <filter string="Sent" name="filter_sent"
                        domain="[('status', '=', 'sent')]"/>
                <filter string="Failed" name="filter_failed"
                        domain="[('status', '=', 'failed')]"/>
                <filter string="Delivered" name="filter_delivered"
                        domain="[('status', '=', 'delivered')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'status'}"/>
                    <filter string="Provider" name="group_provider"
                            context="{'group_by': 'provider_name'}"/>
                    <filter string="Date" name="group_date"
                            context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action window ────────────────────────────────────────────────── -->
    <record id="fayna_sms_log_action" model="ir.actions.act_window">
        <field name="name">SMS Log</field>
        <field name="res_model">fayna.sms.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="fayna_sms_log_view_search"/>
        <field name="context">{'search_default_filter_failed': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No SMS log entries yet.
            </p>
            <p>
                Log entries are created automatically when SMS messages are
                dispatched through a Fayna provider module.
            </p>
        </field>
    </record>

</odoo>
